{
  "name": "rmmj-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./node_modules/@angular/cli/bin/ng.js serve",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build --configuration production && node scripts/finalize-seo.mjs && node scripts/verify-netlify.mjs",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "test:seo": "node --test scripts/seo.test.mjs"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
